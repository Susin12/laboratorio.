
#include <iostream>
using namespace std;

// Prototipos
void leerNumero(int &N);
void descomponerNumero(int N, int &u, int &d,
                       int &c, int &m);
void mostrarDigitos(int u, int d, int c, int m);

int main() {
    int N, u, d, c, m;

    leerNumero(N);

    if (N >= 1 && N < 10000) {
        descomponerNumero(N, u, d, c, m);
        mostrarDigitos(u, d, c, m);
    } else {
        cout << "Numero no valido." << endl;
    }

    return 0;
}

// Leer número
void leerNumero(int &N) {
    cout << "Ingrese un numero entre 1 y 9999: ";
    cin >> N;
}

// Separar dígitos
void descomponerNumero(int N, int &u, int &d,
                       int &c, int &m) {
    u = N % 10;
    d = (N / 10) % 10;
    c = (N / 100) % 10;
    m = (N / 1000) % 10;
}

// Mostrar dígitos
void mostrarDigitos(int u, int d, int c, int m) {
    cout << "Unidades: " << u << endl;
    cout << "Decenas: " << d << endl;
    cout << "Centenas: " << c << endl;
    cout << "Unidades de mil: " << m << endl;
}
