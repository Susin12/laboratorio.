#include <iostream>
using namespace std;

int main() {
    int N;

    do {
        cout << "Ingrese un numero entero positivo: ";
        cin >> N;

        if (N <= 0) {
            cout << "Numero invalido.\n";
        }
    } while (N <= 0);

    int suma = 0;

    for (int i = 1; i <= N; i++) {
        suma = suma + i;
    }

    int numero = N;
    int contador = 0;

    while (numero > 0) {
        contador++;
        numero = numero / 10;
    }

    numero = N;
    int sumaDigitos = 0;

    do {
        sumaDigitos = sumaDigitos + numero % 10;
        numero = numero / 10;
    } while (numero > 0);

    cout << "\nSuma desde 1 hasta N: " << suma << endl;
    cout << "Cantidad de digitos: " << contador << endl;
    cout << "Suma de los digitos: " << sumaDigitos << endl;

    return 0;
}
