
#include <iostream>
using namespace std;

// Prototipos
void leerPeso(double &peso);
double calcularCosto(double peso);
void mostrarResultado(double peso, double costo);

int main() {
    double peso, costo;

    leerPeso(peso);
    costo = calcularCosto(peso);
    mostrarResultado(peso, costo);

    return 0;
}

// Leer el peso
void leerPeso(double &peso) {
    cout << "Ingrese el peso de la carta en gramos: ";
    cin >> peso;
}

// Calcular el costo
double calcularCosto(double peso) {
    double costo;

    if (peso <= 0) {
        return -1;
    } else if (peso < 50) {
        costo = 1.50;
    } else if (peso == 50) {
        return -2;
    } else if (peso <= 100) {
        costo = 4.00;
    } else if (peso <= 200) {
        costo = 6.00;
    } else if (peso <= 350) {
        costo = 10.50;
    } else if (peso <= 500) {
        costo = 15.00;
    } else {
        return -3;
    }

    return costo;
}

// Mostrar el resultado
void mostrarResultado(double peso, double costo) {
    if (costo == -1) {
        cout << "Peso no valido." << endl;
    } else if (costo == -2) {
        cout << "Tarifa no definida para 50 g." << endl;
    } else if (costo == -3) {
        cout << "No puede enviar como carta." << endl;
    } else {
        cout << "Peso: " << peso << " gramos" << endl;
        cout << "Costo de envio: Bs " << costo << endl;
    }
}
