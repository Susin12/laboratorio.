#include <iostream>
using namespace std;

int main() {
    int N;
    double suma = 0;

    cout << "Ingrese un numero entero positivo N: ";
    cin >> N;

    for (int i = 1; i <= N; i++) {
        suma = suma + (1.0 / i);
    }

    cout << "La suma de la serie es: " << suma << endl;

    return 0;
}

